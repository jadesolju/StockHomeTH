# ==========================================
# Supabase Configuration (Database & Storage)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only database write key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Optional legacy variable; supported as a migration path.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Required to authorize scheduled market-data sync requests.
CRON_SECRET=generate-a-long-random-value

# ==========================================
# Firebase Configuration (Admin Auth)
# ==========================================
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK (Server-Side Only)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Messaging (Web Push VAPID Keys)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-firebase-vapid-public-key
FIREBASE_VAPID_PRIVATE_KEY=your-firebase-vapid-private-key

# ==========================================
# Cloudflare Configuration (D1 SQL & R2 Object Storage)
# ==========================================
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-uuid
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Cloudflare R2 (S3-Compatible Object Storage)
CLOUDFLARE_R2_BUCKET_NAME=stockhometh
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://your-custom-or-r2-domain.com

# ==========================================
# App & Security
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-random-32-character-secret-in-production
